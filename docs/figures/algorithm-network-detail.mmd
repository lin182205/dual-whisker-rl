flowchart TB
    INPUT["策略输入 sₜ<br/>批大小 B × 320<br/>每条样本含最近 20 帧、每帧 16 维"]

    subgraph ENCODER["一、共享 GRU 时序特征提取器"]
        direction LR
        RESHAPE["恢复时间轴<br/>B × 320 → B × 20 × 16<br/>顺序为 oₜ₋₁₉，…，oₜ"]
        HZERO["每次前向计算初始化隐藏状态<br/>h₀ = 0，形状 1 × B × 64<br/>不跨并行环境或 episode 保存隐藏状态"]
        GRU["单层 GRU，batch first<br/>输入维度 16，隐藏维度 64<br/>连续复用同一 GRU 单元 20 次<br/>dropout = 0"]
        WEIGHT["GRU 参数张量<br/>输入权重 192 × 16<br/>循环权重 192 × 64<br/>输入偏置与循环偏置各 192"]
        SEQ["序列输出<br/>B × 20 × 64<br/>最终隐藏状态 h₂₀：B × 64"]
        PROJ["共享投影层<br/>Linear 64 → 64，参数 64 × 64 + 64<br/>GELU 激活后得到 fₜ：B × 64"]
        RESHAPE --> GRU --> SEQ --> PROJ
        HZERO --> GRU
        WEIGHT -.-> GRU
    end

    subgraph ACTOR["二、Actor 策略分支"]
        direction LR
        P1["策略隐藏层 1<br/>Linear 64 → 160 + Tanh<br/>参数 160 × 64 + 160<br/>输出 B × 160"]
        P2["策略隐藏层 2<br/>Linear 160 → 160 + Tanh<br/>参数 160 × 160 + 160<br/>输出 B × 160"]
        LOGITS["动作输出层<br/>Linear 160 → 26<br/>参数 26 × 160 + 26<br/>输出 B × 26 logits"]
        SPLIT["按 MultiDiscrete 动作空间拆分<br/>移动 logits：B × 6<br/>左扇区 logits：B × 10<br/>右扇区 logits：B × 10"]
        DIST["三个独立 Categorical 分布<br/>联合 log probability 等于三项之和"]
        ACTION["训练采样或评估取最大概率<br/>联合动作 aₜ：B × 3<br/>每行是移动、左扇区、右扇区"]
        P1 --> P2 --> LOGITS --> SPLIT --> DIST --> ACTION
    end

    subgraph CRITIC["三、Critic 价值分支"]
        direction LR
        V1["价值隐藏层 1<br/>Linear 64 → 160 + Tanh<br/>参数 160 × 64 + 160<br/>输出 B × 160"]
        V2["价值隐藏层 2<br/>Linear 160 → 160 + Tanh<br/>参数 160 × 160 + 160<br/>输出 B × 160"]
        VALUE["价值输出层<br/>Linear 160 → 1<br/>参数 1 × 160 + 1<br/>输出 Vθ(sₜ)：B × 1"]
        V1 --> V2 --> VALUE
    end

    subgraph PARAMS["四、共享边界与可训练参数量"]
        direction LR
        SHARE["仅 GRU 与 64 → 64 投影层共享<br/>Actor 和 Critic 的两层 160 维 MLP 相互独立<br/>Critic 不接收 Actor 已采样动作"]
        COUNT1["共享编码器<br/>GRU 15,744 + 投影 4,160<br/>共 19,904 个参数"]
        COUNT2["Actor 40,346 个参数<br/>Critic 36,321 个参数<br/>全模型共 96,571 个可训练参数"]
        SHARE --> COUNT1 --> COUNT2
    end

    INPUT --> RESHAPE
    PROJ -->|"共享特征 fₜ：B × 64"| P1
    PROJ -->|"共享特征 fₜ：B × 64"| V1
    PROJ --> SHARE
    ACTION -->|"aₜ 与 log πθ(aₜ｜sₜ)"| ROLLOUT["环境执行与 RolloutBuffer"]
    VALUE -->|"Vθ(sₜ)"| ROLLOUT

    style INPUT stroke-width:4px
    style ENCODER stroke-width:4px
    style ACTOR stroke-width:4px
    style CRITIC stroke-width:4px
