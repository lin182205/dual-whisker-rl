flowchart LR
    subgraph RESET["一、无障碍场景初始化"]
        direction TB
        CONFIG["当前训练范围<br/>2 m × 2 m 平面场地，边界为 ±1.0 m<br/>无雷达、无障碍物、无 LBM 风场"]
        SCENE["设置场景<br/>默认随机气源、平均风向、下风侧起点与朝向<br/>也可使用 fixed 模式进行可复现实验"]
        RESETSTATE["重置底盘、触须、传感器和预处理状态<br/>初始化动态 Puff 羽流并预热 80 步"]
        CONFIG --> SCENE --> RESETSTATE
    end

    subgraph STEP["二、一次环境步"]
        direction TB
        ACTION["联合动作 aₜ<br/>移动 6 类、左扇区 10 类、右扇区 10 类"]
        ROBOT["差速底盘更新位姿<br/>前进、左转、右转、左旋、右旋或停止<br/>前进 0.03 m/步，转向约 0.30 rad/步"]
        WIND["更新全局风<br/>平均风向叠加 OU 蜿蜒<br/>随机模式下风速缓慢波动"]
        EMIT["气源释放新 Puff<br/>初始位置、质量和形状带随机扰动"]
        ADVECT["推进全部 Puff<br/>平均风平流 + 每个 Puff 的 OU 湍流速度<br/>同时扩散、质量衰减并清除过期 Puff"]
        WHISKER["左右触须转向目标扇区<br/>施加舵机角速度限制<br/>根据机器人位姿计算左右采样点"]
        FIELD["在左右采样点叠加所有 Puff<br/>得到真实瞬时浓度 cᴸₜ、cᴿₜ"]
        SENSOR["非对称气体传感器模型<br/>响应快、恢复慢，并加入噪声与可选漂移<br/>输出左右传感器读数 yᴸₜ、yᴿₜ"]
        SEARCH["更新气味搜索状态<br/>命中或空白、空白时长、近期底盘与触须运动<br/>重捕获归因为仅触须、底盘辅助或被动"]
        OUT["构造下一观测、七项奖励与 info<br/>判断到源、越界或达到 400 步上限"]
        ACTION --> ROBOT --> WIND --> EMIT --> ADVECT --> WHISKER --> FIELD --> SENSOR --> SEARCH --> OUT
    end

    subgraph OBS["三、单帧观测与历史堆叠"]
        direction TB
        PRE["左右读数在线预处理<br/>signal = reading − baseline<br/>smooth = EMA 信号<br/>trend = 窗口内平滑信号的平均每步变化<br/>各特征按尺度归一化并裁剪"]
        GAS6["6 维气味特征<br/>左、右 normalized signal<br/>左、右 normalized smooth<br/>左、右 normalized trend"]
        DIFF2["2 维左右差分<br/>normalized smooth 左减右<br/>normalized trend 左减右"]
        GEOM4["4 维触须状态<br/>左右实际角度除以 π<br/>左右命令扇区除以 9"]
        BASE12["双触须硬件可部署基础观测<br/>6 + 2 + 4 = 12 维"]
        PROP3["底盘本体感受 3 维<br/>cos heading、sin heading<br/>上一移动动作编号除以 5"]
        BLANK1["blank_age：1 维<br/>连续未检测到气味的步数；若尚未命中过气味，则从 episode 开始累计<br/>blank_age_norm = min(blank_age_steps × 0.2 s ÷ 10 s，1)"]
        FRAME16["当前默认单帧观测 oₜ<br/>12 + 3 + 1 = 16 维"]
        HISTORY["ObservationHistoryWrapper<br/>按时间顺序保存 oₜ₋₁₉ 到 oₜ<br/>拼接为策略输入 sₜ：20 × 16 = 320 维<br/>reset 时用首帧复制填满 20 帧"]
        EXCLUDE["不进入策略观测<br/>真实风向、气源方向、到源距离<br/>Puff 内部状态与真实瞬时浓度"]
        PRE --> GAS6 --> BASE12
        PRE --> DIFF2 --> BASE12
        GEOM4 --> BASE12
        BASE12 --> FRAME16
        PROP3 --> FRAME16
        BLANK1 --> FRAME16
        FRAME16 --> HISTORY
        EXCLUDE -.-> FRAME16
    end

    subgraph REWARD["四、七项训练奖励"]
        direction TB
        VARS["奖励中间量<br/>dₜ：当前到源距离，Δdₜ = dₜ₋₁ − dₜ<br/>cₜ = clip max yᴸₜ，yᴿₜ 到 0 至 1<br/>Δcₜ = max 0，cₜ − episode 历史最佳浓度"]
        R1["① 距离势函数进展<br/>rᵈₜ = 3 Δdₜ"]
        R2["② 历史最佳浓度改善<br/>rᶜₜ = 3 Δcₜ<br/>只有刷新历史最佳值才为正"]
        R3["③ 触须独立重捕获<br/>rʷₜ = 0.25<br/>先闻到、连续空白至少 1 s、近期仅触须运动<br/>每回合最多奖励 4 次"]
        R4["④ 时间成本<br/>rᵗₜ = −0.03，每一步固定扣除"]
        R5["⑤ 停滞惩罚<br/>rˢₜ = −0.02<br/>连续 20 步无位置、距离、浓度进展或重捕获"]
        R6["⑥ 到源奖励<br/>rᵍₜ = +50，当 dₜ ≤ 0.10 m"]
        R7["⑦ 越界惩罚<br/>rᵒₜ = −25，越出 ±1.0 m 边界"]
        TOTAL["单步总奖励<br/>rₜ = rᵈₜ + rᶜₜ + rʷₜ + rᵗₜ + rˢₜ + rᵍₜ + rᵒₜ"]
        END["终止：到源或越界<br/>截断：步数达到 400"]
        VARS --> R1 --> TOTAL
        VARS --> R2 --> TOTAL
        VARS --> R3 --> TOTAL
        VARS --> R4 --> TOTAL
        VARS --> R5 --> TOTAL
        VARS --> R6 --> TOTAL
        VARS --> R7 --> TOTAL
        TOTAL --> END
    end

    RESETSTATE --> ACTION
    SENSOR -->|"左右传感器读数"| PRE
    WHISKER -->|"实际角度与命令扇区"| GEOM4
    ROBOT -->|"航向与上一移动动作"| PROP3
    SEARCH -->|"空白时长"| BLANK1
    OUT -->|"奖励所需状态；真实距离只用于训练与评估"| VARS
    HISTORY -->|"sₜ：320 维"| POLICY["进入 PPO Actor-Critic"]
    TOTAL -->|"rₜ"| BUFFER["进入 RolloutBuffer"]

    style CONFIG stroke-width:4px
    style FRAME16 stroke-width:4px
    style TOTAL stroke-width:4px
