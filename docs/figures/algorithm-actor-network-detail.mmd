flowchart LR
    INPUT["历史观测输入 sₜ<br/>当前默认障碍配置：B × 560<br/>B 为推理或训练批大小"]

    subgraph TEMPORAL["一、共享时序特征提取器"]
        direction TB
        RESHAPE["恢复时间维度<br/>B × 560 → B × 20 × 28<br/>20 帧，每帧 28 维<br/>无可训练参数"]
        GRU["GRU 第 1 层，也是默认唯一循环层<br/>输入维度 28，隐藏维度 64<br/>Wᵢₕ：192 × 28<br/>Wₕₕ：192 × 64<br/>两组偏置：各 192 维<br/>参数量：18,048"]
        GATES["每个时间步计算三个 64 维门<br/>重置门、更新门、候选状态<br/>递推处理 20 帧观测"]
        HIDDEN["取最后一层最终隐藏状态<br/>hₜ：B × 64"]
        PROJ["特征投影层<br/>Linear 64 → 64<br/>权重：64 × 64，偏置：64<br/>参数量：4,160"]
        GELU["GELU 激活<br/>Actor 共享输入特征 fₜ：B × 64"]

        RESHAPE --> GRU --> GATES --> HIDDEN --> PROJ --> GELU
    end

    subgraph ACTOR["二、Actor 专属策略网络"]
        direction TB
        FC1["全连接隐藏层 1<br/>Linear 64 → 160<br/>权重：160 × 64，偏置：160<br/>参数量：10,400<br/>输出：B × 160"]
        TANH1["Tanh 激活<br/>输出范围：−1 至 1<br/>形状保持 B × 160"]
        FC2["全连接隐藏层 2<br/>Linear 160 → 160<br/>权重：160 × 160，偏置：160<br/>参数量：25,760<br/>输出：B × 160"]
        TANH2["Tanh 激活<br/>形状保持 B × 160"]
        ACTIONNET["动作输出层<br/>Linear 160 → 26<br/>权重：26 × 160，偏置：26<br/>参数量：4,186<br/>输出 logits：B × 26"]

        FC1 --> TANH1 --> FC2 --> TANH2 --> ACTIONNET
    end

    subgraph DISTRIBUTIONS["三、MultiDiscrete 动作分布"]
        direction TB
        SPLIT["按动作空间拆分 26 个 logits<br/>6 + 10 + 10"]
        MOVE["移动动作分布<br/>logits：B × 6<br/>forward、turn left、turn right<br/>spin left、spin right、stop"]
        LEFT["左触须扇区分布<br/>logits：B × 10<br/>扇区编号 0 至 9"]
        RIGHT["右触须扇区分布<br/>logits：B × 10<br/>扇区编号 0 至 9"]
        SOFTMAX["每组 logits 独立归一化<br/>形成 3 个 Categorical 分布<br/>该步骤没有可训练参数"]
        SAMPLE["训练采样或评估时取最大概率<br/>联合动作 aₜ：B × 3<br/>移动、左扇区、右扇区"]
        LOGP["联合动作对数概率<br/>log π(aₜ｜sₜ)：B<br/>等于三个分类动作 log probability 之和"]

        SPLIT --> MOVE --> SOFTMAX
        SPLIT --> LEFT --> SOFTMAX
        SPLIT --> RIGHT --> SOFTMAX
        SOFTMAX --> SAMPLE
        SOFTMAX --> LOGP
    end

    PARAMS["Actor 路径参数量<br/>共享 GRU 与投影层：22,208<br/>Actor 专属两层 MLP 与动作层：40,346<br/>从历史观测到动作输出共经过：62,554 个参数<br/>共享部分同时也会被 Critic 损失更新"]

    INPUT -->|"B × 560"| RESHAPE
    GELU -->|"共享特征 B × 64"| FC1
    ACTIONNET -->|"B × 26 logits"| SPLIT
    SAMPLE --> ENV["下发至 8 个移动双触须环境"]
    LOGP --> BUFFER["写入 RolloutBuffer<br/>供 PPO 新旧策略概率比计算"]
    GELU --> PARAMS

    style TEMPORAL stroke-width:4px
    style ACTOR stroke-width:4px
    style DISTRIBUTIONS stroke-width:4px
